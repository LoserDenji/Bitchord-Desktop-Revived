{
  "$schema": "https://tauri.app/schema/tauri.conf.json",
  "package": {
    "productName": "BitChord",
    "version": "0.1.0"
  },
  "tauri": {
    "updater": {
      "active": false
    },
    "window": {
      "title": "BitChord",
      "width": 960,
      "height": 540,
      "minWidth": 768,
      "minHeight": 432,
      "resizable": true,
      "fullscreen": false,
      "fullscreenable": true
    },
    "security": {
      "csp": null,
      "dangerouslyDisableBrowserSandbox": false
    },
    "allowlist": {
      "all": false,
      "fs": {
        "readDir": false,
        "readFile": false,
        "writeFile": false,
        "appendFile": false,
        "mkdir": false,
        "removeFile": false,
        "removeDir": false,
        "copyFile": false
      },
      "path": {
        "all": false,
        "homeDir": true,
        "configDir": true,
        "dataDir": true,
        "runtimeDir": true,
        "desktopDir": true,
        "documentDir": true,
        "downloadDir": true,
        "pictureDir": true,
        "publicDir": false,
        "tempDir": true
      },
      "http": {
        "all": false,
        "request": false
      },
      "shell": {
        "all": false,
        "execute": true,
        "sidecar": false
      },
      "process": {
        "all": false
      },
      "dialog": {
        "all": false,
        "message": true,
        "confirm": true
      },
      "opener": {
        "openExternal": true
      },
      "notification": {
        "all": false
      },
      "clipboard": {
        "all": false
      },
      "system": {
        "all": false,
        "platform": true,
        "version": true
      },
      "state": {
        "all": false
      },
      "app": {
        "all": true,
        "getVersion": true
      },
      "log": {
        "level": "Info"
      }
    },
    "build": {
      "beforeDevCommand": "",
      "beforeBuildCommand": "",
      "devPath": "http://localhost:1420",
      "distDir": "../dist",
      "withGlobalCss": false,
      "devServer": {
        "port": 1420
      }
    },
    "bundle": {
      "active": true,
      "targets": ["all"],
      "identifier": "com.music.bitchord.tauri",
      "icon": [
        "src-tauri/icons/32x32.png",
        "src-tauri/icons/128x128.png",
        "src-tauri/icons/192x192.png",
        "src-tauri/icons/256x256.png",
        "src-tauri/icons/512x512.png"
      ],
      "externalBin": [],
      "beforeCompress": "",
      "afterCompress": "",
      "beforeBundle": "",
      "afterBundle": "",
      "directories": {
        "overlay": {
          "to": "../dist"
        }
      },
      "copyright": "",
      "description": "",
      "publisher": "",
      "shortDescription": "",
      "version": "0.1.0",
      "longDescription": "",
      "category": "AudioVideo",
      "tauriInstallSignature1": "",
      "tauriInstallSignature2": "",
      "windows": {
        "certificatePath": null,
        "privateKeyPath": null,
        "allowExecutionOfExternalBinaryFiles": false,
        "disableSymLink": false,
        " certificateChain": null
      },
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "localhost",
        "entitlements": "src-tauri entitlements.plist",
        "minVersion": "12.0",
        "notarization": {
          "appleId": null,
          "appleIdPassword": null,
          "teamId": null
        }
      },
      "linux": {
        "deb": {
          "maintainer": "BitChord <noreply@example.com>",
          "priority": "optional",
          "section": "utils"
        },
        "AppImage": {
          "embedded": false,
          "compiler": "rustc"
        },
        "rpm": {
          "postInstall": null,
          "preInstall": null,
          "postUninstall": null,
          "preUninstall": null
        },
        "snapcraft": {
          "stagePackages": null
        }
      }
    }
  }
}