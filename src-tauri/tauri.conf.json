{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BitChord",
  "version": "0.2.0",
  "identifier": "com.loser.denji.bitchord",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BitChord",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "custom",
        "trafficLightOffset": { "x": 16, "y": 22 },
        "acceptFirstMouse": true,
        "micaType": "custom"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "tauri": {
    "windows": {
      "mica": true
    }
  }
}
