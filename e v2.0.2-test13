[31m-[m
[31m-# Sourced by the AppRun linuxdeploy generates, after its GTK hook: the tray[m
[31m-# and webview libraries can land in the multiarch dir, and WebKit's sign-in[m
[31m-# windows need a hand from outside the sandbox.[m
[31m-mkdir -p "$appdir/apprun-hooks"[m
[31m-cat > "$appdir/apprun-hooks/zz-bitchord.sh" <<'HOOK'[m
[31m-# WebKit looks its helpers up next to its own library, which may sit in the[m
[31m-# multiarch dir that the stock AppRun doesn't put on the search path.[m
[31m-export LD_LIBRARY_PATH="${APPDIR}/usr/lib/$(uname -m)-linux-gnu:${APPDIR}/usr/lib:${LD_LIBRARY_PATH}"[m
[31m-# The WebKit sandbox needs bubblewrap, which isn't inside the AppImage; turn[m
[31m-# it off (only the sign-in windows use WebKit) unless the user asks for it.[m
[31m-export WEBKIT_FORCE_SANDBOX="${WEBKIT_FORCE_SANDBOX:-0}"[m
[31m-# Older NVIDIA drivers crash WebKit's DMABUF renderer; the main UI never uses[m
[31m-# WebKit, so prefer the safe path.[m
[31m-export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"[m
[31m-HOOK[m
[31m-[m
[31m-# The runners have no FUSE; this makes linuxdeploy and the plugin self-extract.[m
