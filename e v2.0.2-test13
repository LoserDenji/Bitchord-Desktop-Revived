[31m-    https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage[m
[31m-curl -sSLo "$work/plugin-gtk.AppImage" \[m
[31m-    https://github.com/linuxdeploy/linuxdeploy-plugin-gtk/releases/download/continuous/linuxdeploy-plugin-gtk-x86_64.AppImage[m
[31m-chmod +x "$work/linuxdeploy.AppImage" "$work/plugin-gtk.AppImage"[m
[31m-[m
[31m-appdir=$work/AppDir[m
[31m-mkdir -p "$appdir/usr/bin"[m
[31m-cp "$bin" "$appdir/usr/bin/bitchord"[m
