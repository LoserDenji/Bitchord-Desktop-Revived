[1mdiff --git a/linux/deb.sh b/linux/deb.sh[m
[1mnew file mode 100644[m
[1mindex 00000000..a278539d[m
[1m--- /dev/null[m
[1m+++ b/linux/deb.sh[m
[36m@@ -0,0 +1,68 @@[m
[32m+[m[32m#!/bin/sh[m
[32m+[m[32m# Build the .deb: the app in /usr/lib/bitchord, a `bitchord` command, and a menu entry[m
[32m+[m[32m# with its icon. Beside the app goes deb.txt, which has it tell you when a new version[m
[32m+[m[32m# is out instead of updating itself (apt owns the files). A new .deb installs over the[m
[32m+[m[32m# old one.[m
[32m+[m[32m#[m
[32m+[m[32m#   linux/deb.sh <binary> <version> <out dir>[m
[32m+[m[32m#[m
[32m+[m[32m# Needs dpkg-deb and dpkg-shlibdeps (dpkg-dev), which work out the libraries it depends on.[m
[32m+[m[32mset -e[m
[32m+[m
[32m+[m[32mbin=$1[m
[32m+[m[32mversion=$2[m
[32m+[m[32mout=$3[m
[32m+[m[32m[ -f "$bin" ] && [ -n "$version" ] && [ -n "$out" ] || { echo "usage: $0 <binary> <version> <out dir>"; exit 1; }[m
[32m+[m[32mroot=$(cd "$(dirname "$0")/.." && pwd)[m
[32m+[m
[32m+[m[32m# A nightly (2.1.0-nightly.20261111) comes after its version, and before the next, as[m
[32m+[m[32m# in the app's own updater.[m
[32m+[m[32mdebver=$(echo "$version" | sed 's/-nightly\./+nightly./')[m
[32m+[m[32mcase $(uname -m) in[m
[32m+[m[32m    x86_64) arch=amd64 ;;[m
[32m+[m[32m    aarch64) arch=arm64 ;;[m
[32m+[m[32m    *) arch=$(uname -m) ;;[m
[32m+[m[32mesac[m
[32m+[m
[32m+[m[32mwork=$(mktemp -d)[m
[32m+[m[32mtrap 'rm -rf "$work"' EXIT[m
[32m+[m[32mpkg=$work/pkg[m
[32m+[m
[32m+[m[32minstall -Dm755 "$bin" "$pkg/usr/lib/bitchord/bitchord"[m
[32m+[m[32mecho "Installed from the .deb. This file has bitchord tell you about new versions instead of updating itself." > "$pkg/usr/lib/bitchord/deb.txt"[m
[32m+[m[32mmkdir -p "$pkg/usr/bin"[m
[32m+[m[32mln -s ../lib/bitchord/bitchord "$pkg/usr/bin/bitchord"[m
[32m+[m[32minstall -Dm644 "$root/linux/bitchord.desktop" "$pkg/usr/share/applications/bitchord.desktop"[m
[32m+[m[32minstall -Dm644 "$root/assets/icon/icon.png" "$pkg/usr/share/icons/hicolor/256x256/apps/bitchord.png"[m
[32m+[m[32minstall -Dm644 "$root/LICENSE" "$pkg/usr/share/doc/bitchord/copyright"[m
[32m+[m[32mchmod 644 "$pkg/usr/lib/bitchord/deb.txt"[m
[32m+[m
[32m+[m[32m# The libraries it links, at the versions it was built against. The tray's[m
[32m+[m[32m# appindicator is loaded at run time, so it's added by hand.[m
[32m+[m[32mmkdir -p "$work/debian"[m
[32m+[m[32mprintf 'Source: bitchord\n\nPackage: bitchord\nArchitecture: any\n' > "$work/debian/control"[m
[32m+[m[32mshlibs=$(cd "$work" && dpkg-shlibdeps -O "$pkg/usr/lib/bitchord/bitchord" 2>/dev/null | sed -n 's/^shlibs:Depends=//p')[m
[32m+[m[32m[ -n "$shlibs" ] || { echo "dpkg-shlibdeps found no libraries"; exit 1; }[m
[32m+[m[32mdepends="$shlibs, libayatana-appindicator3-1 | libappindicator3-1"[m
[32m+[m
[32m+[m[32mmkdir -p "$pkg/DEBIAN"[m
[32m+[m[32mcat > "$pkg/DEBIAN/control" <<EOF[m
[32m+[m[32mPackage: bitchord[m
[32m+[m[32mVersion: $debver[m
[32m+[m[32mArchitecture: $arch[m
[32m+[m[32mMaintainer: LoserDenji <LoserDenji@users.noreply.github.com>[m
[32m+[m[32mInstalled-Size: $(du -sk "$pkg/usr" | cut -f1)[m
[32m+[m[32mDepends: $depends[m
[32m+[m[32mSection: sound[m
[32m+[m[32mPriority: optional[m
[32m+[m[32mHomepage: https://github.com/LoserDenji/Bitchord-Desktop-Revived[m
[32m+[m[32mDescription: Native BitChord client[m
[32m+[m[32m A YouTube Music desktop client: search, browse and play music from[m
[32m+[m[32m YouTube Music, with word-synced lyrics, themes, Listen Together and[m
[32m+[m[32m Spotify transfer.[m
[32m+[m[32mEOF[m
[32m+[m
[32m+[m[32mmkdir -p "$out"[m
[32m+[m[32mdeb="$out/bitchord_${debver}_$arch.deb"[m
[32m+[m[32mdpkg-deb --build --root-owner-group "$pkg" "$deb"[m
[32m+[m[32mecho "Built $deb"[m
