[31m-[ -f "$here/bitchord" ] || { echo "Run install.sh from the extracted download."; exit 1; }[m
[32m+[m[32mhere=$(cd "$(dirname "$0")" 2>/dev/null && pwd || true)[m
[32m+[m[32mif [ ! -f "$here/bitchord" ]; then[m
[32m+[m[32m    repo=LoserDenji/Bitchord-Desktop-Revived[m
[32m+[m[32m    arch=$(uname -m)[m
[32m+[m[32m    tmp=$(mktemp -d)[m
[32m+[m[32m    trap 'rm -rf "$tmp"' EXIT[m
[32m+[m[32m    url=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" | grep -o "https://[^\"]*/BitChord-[0-9][^\"/]*-linux-$arch\.tar\.gz" | head -n 1)[m
[32m+[m[32m    [ -n "$url" ] || { echo "No Linux $arch download in the latest release."; exit 1; }[m
[32m+[m[32m    echo "Downloading $(basename "$url")"[m
[32m+[m[32m    curl -fL# "$url" | tar -xz -C "$tmp"[m
[32m+[m[32m    here=$(dirname "$(find "$tmp" -name bitchord -type f | head -n 1)")[m
[32m+[m[32mfi[m
 [m
 mkdir -p "$lib" "$bin" "$data/applications" "$(dirname "$icon")"[m
